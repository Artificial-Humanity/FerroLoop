# generated by fl install {{RELEASE}}
# The FerroWire relay: the local Unix socket and the peer WebSocket relay. A listen address,
# peers and the token file come from [wire] in the fl config, never from this unit.
# This unit holds no secret.
[Unit]
Description=FerroWire daemon (local socket and peer relay)
PartOf=ferrostore.service
After=ferrostore.service

[Service]
Type=simple
ExecStart={{LAUNCHER}} wire daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
