# generated by fl install {{RELEASE}}
# Serves the workspace store (`fl store serve`) on its Unix socket. A client that opens the
# store finds the socket beside the .fls file and uses the server instead of the file.
# The store is the one `fl` resolves for every command ([state] store, else the XDG default).
# This unit holds no secret.
[Unit]
Description=FerroStore server (workspace store)

[Service]
Type=simple
ExecStart={{LAUNCHER}} store serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
