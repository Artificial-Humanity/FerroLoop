# generated by fl install {{RELEASE}}
# The FerroLoop Hub (HTTP and WebSocket) and the FerroDeck command center. The UI bundle is the
# installed release's (`current` moves with an upgrade); --ui-dir wins over [hub] ui_dir.
# This is the headless, UI-serving shape. With no WorkingDirectory the hub starts in the home
# directory, which is also its repository root: the views that need a repository (worktrees,
# worktree diffs, architecture, commands and skills, repo paths) show nothing useful, code
# search answers empty (it never scans the home directory), and an owner terminal session starts
# in the home directory. A hub bound to a repository names it in the fl config:
#   [hub]
#   repo_root = "/path/to/repo"     # absolute, an existing directory; --repo-root wins over it
# NoNewPrivileges is not set: an owner terminal session runs sudo.
# This unit holds no secret; the owner token comes from [hub] owner_token_file.
[Unit]
Description=FerroLoop Hub HTTP/1.1 & WebSocket Daemon (FerroDeck Command Center)
Wants=ferrostore.service ferrowire.service
After=ferrostore.service ferrowire.service

[Service]
Type=simple
ExecStart={{LAUNCHER}} hub serve --listen 127.0.0.1:8420 --ui-dir {{PREFIX}}/current/ui/dist
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
