# generated by fl install {{RELEASE}}
# The FerroLoop Hub (HTTP and WebSocket) and the FerroDeck command center. The UI bundle is the
# installed release's (`current` moves with an upgrade); --ui-dir wins over [hub] ui_dir.
# The hub starts in the home directory: a terminal session it opens starts there too.
# NoNewPrivileges is not set: an owner terminal session runs sudo.
# This unit holds no secret; the owner token comes from [hub] owner_token_file.
[Unit]
Description=FerroLoop Hub HTTP/1.1 & WebSocket Daemon (FerroDeck Command Center)
Wants=ferrostore.service ferrowire.service
After=ferrostore.service ferrowire.service

[Service]
Type=simple
ExecStart={{LAUNCHER}} hub serve --listen 127.0.0.1:8420 --ui-dir {{PREFIX}}/current/ui/dist
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
