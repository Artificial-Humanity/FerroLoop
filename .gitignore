# Rust build artifacts
/target
/target-musl
**/*.rs.bk
*.pdb

# Working notes live in the umbrella `Notes/` repo, which is private.
# `notes` here is a symlink to ../Notes/FerroLoop and must stay untracked.
# ⚠ NO TRAILING SLASH. Git reads `notes/` as "directory only", and a symlink is not a
# directory, so `notes/` would silently fail to ignore it and the link would be committed.
/notes

# OS and editor cruft
.DS_Store
Thumbs.db

# Subagent-driven-development scratch (ledger, briefs, review packages).
/.superpowers

# FerroDeck UI build and dependency artifacts
/ui/node_modules
/ui/dist
/ui/.vite
node_modules/
dist/

# Secrets: keys, certificates, keystores, env files and vault blobs are never committed.
*.pem
*.key
*.p12
*.pfx
*.psk
.env
.env.*
vault.enc
# Env templates hold no secrets and stay tracked.
!.env.example
# Test-only TLS fixtures (throwaway keys for the store's TLS tests).
!/crates/store/src/ferrostore/testdata/tls/ca.pem
!/crates/store/src/ferrostore/testdata/tls/expired.pem
!/crates/store/src/ferrostore/testdata/tls/other-ca.pem
!/crates/store/src/ferrostore/testdata/tls/server.key
!/crates/store/src/ferrostore/testdata/tls/server.pem
!/crates/store/src/ferrostore/testdata/tls/wrong-host.pem

# MCP vendor files: `fl mcp sync` writes them on each machine from .fl/mcp.toml (docs/mcp.md).
/.mcp.json
/.codex/config.toml
/.agents/mcp_config.json
/.muse/settings.json
/.grok/config.toml
