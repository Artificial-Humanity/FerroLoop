// FerroStore as it runs on main@386cb6a7 (2026-11-09), and the single-owner
// target of Milestone 6 (Record 188). Relationships tagged #today describe the
// code now; relationships tagged #target are the proposed end state and are
// not built. Evidence: README.md beside this file.

model {
  operator = actor 'Operator' {
    description 'Owner using FerroDeck, the fl CLI or an agent session'
  }

  ferroloop = system 'FerroLoop on one host' {

    // ---- Long-lived processes -------------------------------------------

    wsDaemon = service 'ferrostore.service' {
      description 'ferrostore serve --store fl.fls --socket fl.fls.sock. Long-lived embedded owner of the workspace store and its FerroMQ topics.'
      technology 'systemd user unit, crates/store/src/cli/serve.rs'
    }
    projDaemon = service 'ferrostore@{slug}.service' {
      description 'One instance per served project store: ferroloop, kaggle-gemma4, lucida, prosodia, sonora, website.'
      technology 'systemd user template unit'
    }
    councilDaemon = service 'ferrostore@the-council.service' {
      #target
      description 'Proposed: no unit exists today.'
    }
    websiteAltDaemon = service 'ferrostore@ferroloop-website.service' {
      #target
      description 'Proposed: no unit exists today. Or retire the file if it is unused.'
    }
    wireDaemon = service 'ferrowire.service' {
      description 'fl wire daemon. Opens one long-lived workspace store handle at startup; remote when ferrostore.service is up, embedded otherwise.'
      technology 'crates/cli/src/cmd/wire.rs, crates/wire/src/daemon.rs'
    }
    hub = service 'ferroloop-hub.service' {
      description 'fl hub serve. Opens stores per request: workspace store under a hub-wide mutex, project stores under a per-path lock. Caches read-only code-index handles.'
      technology 'crates/hub/src/lib.rs'
    }
    host = service 'ferroloop-host.service' {
      description 'fl-host. No fl-store dependency.'
      technology 'crates/host'
    }

    // ---- Short-lived callers --------------------------------------------

    cli = caller 'fl CLI' {
      description 'One store open per invocation (state, wire, agent, gate, attempt, ledger, flow, doctor, ...). IRI lookups scan other bound stores.'
      technology 'crates/cli/src/main.rs open_store'
    }
    stateMcp = caller 'ferrostate MCP' {
      description 'fl state mcp / fl wire mcp stdio server. Opens the store on every tool call; opens and syncs the code index per search batch.'
      technology 'crates/cli/src/cmd/state_mcp.rs'
    }
    storeCli = caller 'ferrostore get/put/query' {
      description 'Data subcommands of the ferrostore binary. Always open the file embedded, even while a daemon serves it.'
      technology 'crates/store/src/cli/data.rs'
    }

    // ---- Store files (~/.local/share/fl) --------------------------------

    flFls = storefile 'fl.fls' {
      #served
      description 'Workspace store (72 MB): agents, wire mail, state entries, hosted-session runtime entries.'
    }
    projectFls = storefile '{slug}.fls' {
      #served
      description 'Served project stores: ferroloop (76 MB), kaggle-gemma4, lucida, prosodia, sonora, website.'
    }
    councilFls = storefile 'the-council.fls' {
      #unserved
      description 'Bound directly in config.toml. No daemon: every caller opens it embedded.'
    }
    websiteAltFls = storefile 'ferroloop-website.fls' {
      #unserved
      description 'Bound as .redb (maps to .fls). No daemon: every caller opens it embedded.'
    }
    codeFls = storefile 'fl.code.fls' {
      #derived
      description 'Code-index sidecar (23 MB). Always embedded, even when the primary store is remote. Rebuilt when deleted.'
    }
    legacyRedb = storefile '*.redb (read-only)' {
      #legacy
      description 'Pre-migration redb copies, chmod 0400. The only backup that exists today.'
    }

    // ---- The fl-store library (crates/store, ~81k LOC incl. tests) -------

    flStore = system 'fl-store library' {
      description 'Linked into every caller above. One handle type, two engines, an RPC client and server.'

      anyStore = module 'AnyStore' {
        description 'Engine choice: a .fls path is always ferro; otherwise FL_STORE_BACKEND, default ferro. Maps x.redb to x.fls. Delegates the 13 domain traits.'
        technology 'any.rs'
      }
      openAuto = module 'FerroStore::auto' {
        description 'If <file>.fls.sock accepts, the handle is Remote; if nothing listens, open the file embedded. A failed handshake is an error.'
        technology 'ferrostore/mod.rs'
      }
      diskEngine = module 'Ferro engine (Disk)' {
        description 'Snapshot + CRC-framed WAL over a JSON document map, dual superblocks, group commit, auto-checkpoint 4 MiB, auto-compaction 64 MiB. A second embedded open of the same file succeeds; flock only around commit, checkpoint and compaction.'
        technology 'ferrostore/{mod,layout,container_io,group,transaction,compact}.rs'
      }
      remoteClient = module 'Remote client' {
        description '47 Inner::Remote branches. Domain traits run client-side over a remote Txn: one txn_read per read, commit validated by read-set hash, retried up to 8 times.'
        technology 'ferrostore/mod.rs, remote_txn.rs'
      }
      rpcServer = module 'RPC server' {
        description '37 generic primitives over Unix socket (length-prefixed JSON) and ws/wss; auth, scopes, request-id dedupe. Documented as the only opener, but nothing enforces it.'
        technology 'ferrostore/{server,auth,tls,ws,session}.rs'
      }
      redbEngine = module 'RedbStore' {
        description 'Legacy engine, selectable with FL_STORE_BACKEND=redb for non-.fls paths.'
        technology 'lib.rs, state.rs, ferrowire.rs, workflow.rs'
      }
      migrate = module 'redb -> .fls migration' {
        description 'Verified table-by-table copy under a MigrationLock, then the redb is made read-only.'
        technology 'ferrostore/migrate.rs, any.rs open_ferro'
      }
      ferroMq = module 'FerroMQ' {
        #gap
        description 'Topics as mq:{topic} collections. No production publisher; one consumer reads mq_telemetry.'
        technology 'mq_buffer.rs, mq_runtime.rs, mq_tier.rs'
      }
      vectorCol = module 'Vector (HNSW) + columnar' {
        technology 'vector.rs, columnar.rs'
      }
      knowledge = module 'FerroState search' {
        description 'Exact BM25 over state entries fused by RRF with an HNSW leg (ferro only).'
        technology 'knowledge.rs, fl_core::search_state_entries'
      }
      codeKnowledge = module 'Code index' {
        description 'Name tiers and line matches; vectors in the <primary>.code.fls sidecar.'
        technology 'code_knowledge.rs'
      }
      wireDelivery = module 'WireDeliveryStore / F1 records' {
        #gap
        description 'Preparatory and disabled on every backend. No production caller.'
        technology 'traits_wire_delivery.rs, f1_preparation.rs'
      }
    }
  }

  // ===== Library internals (today) ======================================

  ferroloop.flStore.anyStore -[uses]-> ferroloop.flStore.openAuto 'opens .fls via' { #today }
  ferroloop.flStore.anyStore -[uses]-> ferroloop.flStore.redbEngine 'non-.fls path with FL_STORE_BACKEND=redb' { #today }
  ferroloop.flStore.anyStore -[uses]-> ferroloop.flStore.migrate 'lone .redb on first open' { #today }
  ferroloop.flStore.openAuto -[uses]-> ferroloop.flStore.remoteClient 'socket accepts' { #today }
  ferroloop.flStore.openAuto -[uses]-> ferroloop.flStore.diskEngine 'no listener' { #today }
  ferroloop.flStore.remoteClient -[socket]-> ferroloop.flStore.rpcServer 'txn_read / commit_txn' { #today }
  ferroloop.flStore.rpcServer -[uses]-> ferroloop.flStore.diskEngine 'serves one embedded handle' { #today }
  ferroloop.flStore.diskEngine -[uses]-> ferroloop.flStore.ferroMq { #today }
  ferroloop.flStore.diskEngine -[uses]-> ferroloop.flStore.vectorCol { #today }
  ferroloop.flStore.knowledge -[uses]-> ferroloop.flStore.vectorCol 'HNSW leg' { #today }
  ferroloop.flStore.codeKnowledge -[embedded]-> ferroloop.codeFls 'always embedded' { #today }
  ferroloop.flStore.migrate -[embedded]-> ferroloop.legacyRedb 'read once, then chmod 0400' { #today }

  // ===== Who opens which file (today) ===================================

  ferroloop.wsDaemon -[embedded]-> ferroloop.flFls 'long-lived owner, rw' { #today }
  ferroloop.projDaemon -[embedded]-> ferroloop.projectFls 'long-lived owner, rw' { #today }

  ferroloop.wireDaemon -[socket]-> ferroloop.wsDaemon 'long-lived handle, rw (embedded fl.fls if the daemon is down)' { #today }

  ferroloop.hub -[socket]-> ferroloop.wsDaemon 'per request, hub-wide mutex, rw' { #today }
  ferroloop.hub -[socket]-> ferroloop.projDaemon 'per request, per-path lock, rw' { #today }
  ferroloop.hub -[embedded]-> ferroloop.councilFls 'per request, rw' { #today #gap }
  ferroloop.hub -[embedded]-> ferroloop.websiteAltFls 'per request, rw' { #today #gap }
  ferroloop.hub -[embedded]-> ferroloop.codeFls 'cached read-only handle' { #today }

  ferroloop.cli -[socket]-> ferroloop.wsDaemon 'per invocation, rw' { #today }
  ferroloop.cli -[socket]-> ferroloop.projDaemon 'per invocation; scan opens for IRI lookup' { #today }
  ferroloop.cli -[embedded]-> ferroloop.councilFls 'per invocation, rw' { #today #gap }
  ferroloop.cli -[embedded]-> ferroloop.websiteAltFls 'per invocation, rw' { #today #gap }
  ferroloop.cli -[embedded]-> ferroloop.codeFls 'index sync, rw' { #today }
  ferroloop.cli -[uses]-> ferroloop.wireDaemon 'fl wire send (direct store write if the daemon is down)' { #today }

  ferroloop.stateMcp -[socket]-> ferroloop.wsDaemon 'new connection per tool call' { #today #gap }
  ferroloop.stateMcp -[socket]-> ferroloop.projDaemon 'new connection per tool call' { #today #gap }
  ferroloop.stateMcp -[embedded]-> ferroloop.councilFls 'full load per tool call' { #today #gap }
  ferroloop.stateMcp -[embedded]-> ferroloop.codeFls 'open + sync per search batch, rw' { #today }

  ferroloop.storeCli -[embedded]-> ferroloop.flFls 'bypasses the serving daemon' { #today #gap }
  ferroloop.storeCli -[embedded]-> ferroloop.projectFls 'bypasses the serving daemon' { #today #gap }

  operator -[uses]-> ferroloop.hub 'FerroDeck' { #today }
  operator -[uses]-> ferroloop.cli { #today }
  operator -[uses]-> ferroloop.stateMcp 'via agent sessions' { #today }

  // ===== Proposed single-owner end state (Milestone 6) ===================
  // Each .fls has exactly one opener: its ferrostore daemon, holding an
  // exclusive lock. Everything else is a socket client.

  ferroloop.wsDaemon -[embedded]-> ferroloop.flFls 'sole opener, exclusive lock' { #target }
  ferroloop.projDaemon -[embedded]-> ferroloop.projectFls 'sole opener, exclusive lock' { #target }
  ferroloop.councilDaemon -[embedded]-> ferroloop.councilFls 'sole opener, exclusive lock' { #target }
  ferroloop.websiteAltDaemon -[embedded]-> ferroloop.websiteAltFls 'sole opener, or retire the file' { #target }

  ferroloop.wireDaemon -[socket]-> ferroloop.wsDaemon 'long-lived; no embedded fallback' { #target }
  ferroloop.hub -[socket]-> ferroloop.wsDaemon 'reused connection, no hub-wide mutex' { #target }
  ferroloop.hub -[socket]-> ferroloop.projDaemon 'reused connection' { #target }
  ferroloop.hub -[socket]-> ferroloop.councilDaemon 'reused connection' { #target }
  ferroloop.cli -[socket]-> ferroloop.wsDaemon 'per invocation; clear error if the daemon is down' { #target }
  ferroloop.cli -[socket]-> ferroloop.projDaemon { #target }
  ferroloop.cli -[socket]-> ferroloop.councilDaemon { #target }
  ferroloop.stateMcp -[socket]-> ferroloop.wsDaemon 'one long-lived connection per MCP process' { #target }
  ferroloop.stateMcp -[socket]-> ferroloop.projDaemon 'one long-lived connection per MCP process' { #target }
  ferroloop.stateMcp -[socket]-> ferroloop.councilDaemon 'one long-lived connection per MCP process' { #target }
  ferroloop.storeCli -[socket]-> ferroloop.wsDaemon 'go through the daemon when one serves the file' { #target }
}
